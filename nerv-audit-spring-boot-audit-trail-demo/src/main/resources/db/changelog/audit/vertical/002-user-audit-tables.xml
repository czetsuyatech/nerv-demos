<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="vertical-audit-schema" author="czetsuya" dbms="postgresql">
    <createSequence sequenceName="revinfo_seq" schemaName="${schemaName}" startValue="1" incrementBy="50"/>
    <sql>SET LOCAL search_path TO ${schemaName}</sql>
    <sqlFile path="user_account_aud.sql" relativeToChangelogFile="true" splitStatements="false"/>
    <sqlFile path="user_address_aud.sql" relativeToChangelogFile="true" splitStatements="false"/>
    <sqlFile path="user_hobby_aud.sql" relativeToChangelogFile="true" splitStatements="false"/>
  </changeSet>
</databaseChangeLog>
